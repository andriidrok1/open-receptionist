# open-receptionist — environment
# Copy to .env and fill in your keys:  cp .env.example .env

# --- Which business is this process serving? ---
# A file name from businesses/ without the extension:
#   hotel | clinic | barbershop | cleaning | emergency
BUSINESS=hotel
# Or an absolute path to a YAML outside the repo — this is how you keep a real
# client's config out of version control:
# BUSINESS_CONFIG=/srv/clients/dnipro-hotel.yaml
# Database file. Defaults to server/<business>.db
# CRM_DB=

# --- OpenAI: the LLM, plus fallback speech-to-text and text-to-speech ---
# Key: https://platform.openai.com/api-keys (needs a balance, ~$5 is plenty to try)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Speech-to-text: elevenlabs (better for Ukrainian) | openai ---
STT_PROVIDER=elevenlabs
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# Fallback only. gpt-realtime-whisper does NOT support turn_detection, so if you
# switch to the OpenAI provider you need a model that does.
OPENAI_STT_MODEL=gpt-4o-transcribe
# near_field for a laptop mic, far_field for a room or a speakerphone.
OPENAI_STT_NOISE=near_field

# --- Text-to-speech ---
# Without ELEVENLABS_API_KEY the pipeline falls back to OpenAI's voices.
# Key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# The voice is a property of the business (`voice_id:` in businesses/*.yaml),
# falling back to the language pack's default. Setting it here overrides every
# business that does not name its own — useful for comparing voices, wrong for
# running several businesses at once.
# ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_SPEED=0.95
ELEVENLABS_STABILITY=0.4
ELEVENLABS_STYLE=1.0
# OpenAI fallback voice: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage,
# shimmer, verse
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral

# --- Speech quality knobs you may actually want to change ---
# 1 = synthesise the whole reply at once, so intonation carries across sentences
# instead of every sentence ending in a full stop. Costs roughly 0.7s of latency.
# Set to 0 if you would rather have the fastest possible response.
TTS_WHOLE_REPLY=1
# How long to wait for the first byte of audio before giving up on an utterance.
# The library default is 3s, which silently drops entire replies when the
# synthesiser is briefly slow — and then stays paused for the rest of the turn.
TTS_FIRST_BYTE_TIMEOUT=10
# ws = streaming multi-context (default, keeps intonation across a reply)
# http = one request per chunk, kept as a fallback
ELEVENLABS_TTS_TRANSPORT=ws

# --- Telephony (only for `bot.py -t twilio`, see docs/telephony.md) ---
# Both are on the Twilio Console home page under "Account Info". Not used to
# receive calls — the bot needs them to HANG UP through Twilio's REST API when
# the agent says goodbye. Phone mode refuses to start without them.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- Limits ---
# Hard cap on call length, in seconds. 0 disables it. Only meaningful for a
# public demo — a real receptionist should not hang up on a customer.
MAX_CALL_SECONDS=0

# --- Owner dashboard ---
# The password the owner signs in with. REQUIRED for any install the owner
# opens from their own phone: without it the dashboard answers only to
# localhost, because the page holds every customer's name and number.
# Changing it signs every browser out (sessions are keyed off the password).
# DASHBOARD_PASSWORD=
# Overrides the names from the YAML if you need to:
# BRAND=Riviera Hotel
# BRAND_CITY=Odesa, Ukraine
# AGENT_NAME=Oksana
# DASHBOARD_PORT=8000
