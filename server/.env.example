# voice-receptionist — змінні оточення
# Скопіюй у .env і встав свій ключ:  cp .env.example .env

# --- Який заклад обслуговуємо ---
# Ім'я файлу з businesses/ без розширення: hotel | clinic | barbershop
BUSINESS=hotel
# Або шлях до YAML поза репозиторієм (конфіг конкретного клієнта):
# BUSINESS_CONFIG=/home/andrii/clients/dnipro-hotel.yaml
# База даних. За замовчуванням server/<business>.db
# CRM_DB=

# --- OpenAI (LLM + запасний STT/TTS) ---
# Ключ: https://platform.openai.com/api-keys  (потрібен баланс у Billing, ~$5)
OPENAI_API_KEY=

# LLM — "мозок" діалогу
OPENAI_MODEL=gpt-4o-mini

# --- STT (розпізнавання мови): elevenlabs (краще для української) | openai ---
STT_PROVIDER=elevenlabs
# ElevenLabs STT-модель (потоковий realtime)
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# Запасний OpenAI STT (server_vad; gpt-realtime-whisper НЕ вміє turn_detection)
OPENAI_STT_MODEL=gpt-4o-transcribe
# TTS-відкат (використовується, лише якщо ELEVENLABS_API_KEY не заданий)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Голос: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
OPENAI_VOICE=coral

# --- ElevenLabs (TTS, основний голос) ---
# Ключ: https://elevenlabs.io/app/settings/api-keys
# Голос за замовчуванням — Kateryna Pavlenko (нативна українська, з бібліотеки).
# Налаштування підібрані на слух, див. README і server/voice_lab.py.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=bsourKGZEagmttzrIzmu
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_SPEED=0.95
ELEVENLABS_STABILITY=0.4
ELEVENLABS_STYLE=1.0

# --- Дашборд (перекриває назву з YAML, якщо треба) ---
# BRAND=Riviera Hotel
# BRAND_CITY=Одеса, Україна
# AGENT_NAME=Оксана
# DASHBOARD_PORT=8000
