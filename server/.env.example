# hotel-voice-agent — змінні оточення
# Скопіюй у .env і встав свій ключ:  cp .env.example .env
# Увесь стек (STT + LLM + TTS) працює на ОДНОМУ ключі OpenAI.

# --- OpenAI (LLM + запасний STT/TTS) ---
# Ключ: https://platform.openai.com/api-keys  (потрібен баланс у Billing, ~$5)
OPENAI_API_KEY=

# LLM — "мозок" діалогу
OPENAI_MODEL=gpt-4o-mini

# --- STT (розпізнавання мови): elevenlabs (краще для української) | openai ---
STT_PROVIDER=elevenlabs
# ElevenLabs STT-модель (потоковий realtime)
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# Запасний OpenAI STT (server_vad; gpt-realtime-whisper НЕ вміє turn_detection)
OPENAI_STT_MODEL=gpt-4o-transcribe
# TTS-відкат (використовується, лише якщо ELEVENLABS_API_KEY не заданий)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Голос: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
OPENAI_VOICE=coral

# --- ElevenLabs (TTS, основний голос — живіший за OpenAI українською) ---
# Ключ: https://elevenlabs.io/app/settings/api-keys
# Free-тариф: ~10к символів/міс, працюють лише premade-голоси
# (Sarah EXAVITQu4vr4xnSDxMaL, Lily pFZP5JQG7iQjIQuC4Bku, Alice Xb7hH8MSUJpSbSDYk0k2,
#  Matilda XrExE9yKIg1WjnnlVkGX, Jessica cgSgspJ2msm6clMCkdW9)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# 1.0 = стандартний темп; 0.95 = трохи повільніше
ELEVENLABS_SPEED=0.95

# --- Готель ---
HOTEL_NAME=готель «Дніпро»
