# hotel-voice-agent — змінні оточення
# Скопіюй у .env і встав свої ключі:  cp .env.example .env

# --- Deepgram (STT, розпізнавання української) ---
# Ключ: https://console.deepgram.com/  (є безкоштовний кредит)
DEEPGRAM_API_KEY=

# --- ElevenLabs (TTS, озвучка українською) ---
# Ключ: https://elevenlabs.io/  →  Profile → API Keys
ELEVENLABS_API_KEY=
# ID голосу з бібліотеки ElevenLabs (краще мультимовний / український голос).
# Voices → обери голос → кнопка "ID". Напр. дефолтний Rachel: 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID=
# Модель TTS: eleven_flash_v2_5 = низька затримка + українська (за замовч.)
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Anthropic Claude (LLM) ---
# Ключ: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Швидка модель для низької затримки в розмові:
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Готель ---
HOTEL_NAME=готель «Дніпро»
